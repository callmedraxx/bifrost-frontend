# These are SERVER-ONLY env vars (no NEXT_PUBLIC_ prefix), so they stay on the
# server and are never shipped to the browser. The UI calls this app's own
# /api routes, which forward to the backend using these.

# Base URL of the Bifrost backend.
BIFROST_URL=http://localhost:8088
# Against the droplet once exposed:
# BIFROST_URL=http://206.189.100.31:8088

# Bearer token the backend requires (must match the backend's BIFROST_API_KEY).
# Leave empty only if the backend has no BIFROST_API_KEY set.
BIFROST_API_KEY=
